# Local server only. Put your own Nebius Token Factory API key here.
AI_API_KEY=
AI_BASE_URL=https://api.tokenfactory.nebius.com/v1
AI_MODEL=nvidia/Nemotron-3_5-Lightning

# Optional Supabase browser configuration (leave blank for local-only use).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Deployment only (server environment, never VITE_):
# NODE_ENV=production
# PORT=3001
# APP_ACCESS_PASSWORD=choose-a-demo-password-with-at-least-12-characters
# SESSION_SECRET=generate-a-random-secret-with-at-least-32-characters
# APP_ORIGIN=https://your-deployment.example
AI_DAILY_REQUEST_LIMIT=100
AI_REQUESTS_PER_MINUTE=8
